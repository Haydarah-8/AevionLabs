# Preferred URL for canonicals, sitemap, OG (apex, no www). Both apex and www can serve the site on Vercel;
# add www in Vercel Domains + a www CNAME at your DNS provider. `getSiteUrl()` forces https and strips www.
NEXT_PUBLIC_SITE_URL=https://elijahwgroup.com

# Optional: override Google Search Console meta verification (default token is set in src/app/layout.tsx).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Browser auth (publishable key). Never put the service role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

-- Server-only. Then run supabase/schema.sql and supabase/cms.sql in the
-- Supabase SQL Editor (cms.sql is already applied on the linked project).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login is Supabase Auth only (no signup). Create the user in the
# dashboard and set app_metadata.role = "admin". Disable public sign-ups
# under Authentication → Providers → Email.

# Optional news intake (Recent Events). Free RSS from the news_sources registry
# (BBC, Reuters, AP, Al Jazeera, Sky, CNN, NPR, ABC). No Guardian.
GUARDIAN_API_KEY=
NEWS_API_KEY=
GNEWS_API_KEY=

# Live news aggregation (/live). Free RSS (BBC, Guardian, Reuters, Google News)
# needs no key. GDELT is optional; GDELT_API_URL overrides the public DOC API.
GDELT_API_URL=
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
# GNEWS_API_KEY and GUARDIAN_API_KEY above are also used by live ingest.

# Admin news worker (workers/news-ingest). Not used by Vercel serverless.
RSSHUB_BASE_URL=
NEWS_EXTRACT_URL=http://127.0.0.1:8788/extract
NEWS_WORKER_SECRET=
AI_PROVIDER=rules
AI_API_KEY=

# Vercel Cron Authorization: Bearer CRON_SECRET
# Native Vercel crons are disabled (Hobby plan blocks deploy). Use GitHub Actions
# workflow .github/workflows/news-ingest-cron.yml with CRON_SECRET + SITE_URL secrets,
# or an external scheduler hitting /api/cron/news/ingest.
CRON_SECRET=

# Optional last-resort scraper, for pages a publisher refuses us outright
# (401/403/451). Everything else — our own fetch, the retry, the honest
# user-agent — is free and handles the overwhelming majority; this is only for
# outlets that mean their "no". Leave it unset and the pipeline behaves exactly
# as before.
#
# It is metered per page, so FIRECRAWL_MAX_PER_RUN is a spending limit rather
# than a tuning knob: the cron fires 48 times a day, so 2 is up to 96 scrapes a
# day and 10 is 480. Raise it against the usage figure on the Firecrawl
# dashboard, never because a backlog looks slow. The enrich cron reports how
# many it spent under "firecrawl".
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_PER_RUN=2

# Website Factory. Leave Vercel empty until you want Deploy to Vercel to run.
# Path-based preview/live works without these: /p/{slug} and /s/{slug}.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
FACTORY_WILDCARD_DOMAIN=
FACTORY_PUBLIC_HOST=

# Optional model for the studio command bar. Unset = structured rule plans only.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

